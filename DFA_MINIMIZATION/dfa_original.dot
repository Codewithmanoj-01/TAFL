digraph DFA {
    rankdir=LR;
    node [shape=circle];
    "q2" [shape=doublecircle];
    "q3" [shape=doublecircle];
    start [shape=point];
    start -> "q0";
    "q0" -> "q1" [label="0"];
    "q0" -> "q2" [label="1"];
    "q1" -> "q2" [label="1"];
    "q1" -> "q3" [label="0"];
    "q2" -> "q2" [label="0,1"];
    "q3" -> "q5" [label="0,1"];
    "q4" -> "q5" [label="0,1"];
    "q5" -> "q5" [label="0,1"];
}
