digraph DFA {
    rankdir=LR;
    node [shape=circle];
    "q0q1q2" [shape=doublecircle];
    start [shape=point];
    start -> "q0";
    "q0" -> "q0" [label="0"];
    "q0" -> "q0q1" [label="1"];
    "q0q1" -> "q0q1" [label="0"];
    "q0q1" -> "q0q1q2" [label="1"];
    "q0q1q2" -> "q0q1q2" [label="0,1"];
}
